<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zbkj.service.dao.FlowerOrderProgressDao">
    <select id="selectByOrderId" resultType="com.zbkj.common.model.flower.FlowerOrderProgress">
        SELECT *
        FROM eb_flower_order_progress
        WHERE order_id = #{orderId}
        ORDER BY create_time ASC, id ASC
    </select>
</mapper>
